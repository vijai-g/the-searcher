# ---------------------------------------------------------------------------
# The Searcher - local configuration
# ---------------------------------------------------------------------------
CONFLUENCE_BASE_URL=https://kb.epam.com
CONFLUENCE_PAT=

# Leave empty: The Searcher ranks every space with hits by evidence density and
# focuses on the ones that clearly hold the topic. Set only to force a manual list.
SEARCH_SPACES=
MAX_PAGES=200
REQUEST_DELAY_MS=200

# strict | linked | all   (strict = page must mention the term)
RELEVANCE_MODE=strict

# ---------------------------------------------------------------------------
# Chat model for the organiser and Q&A answers.
#   auto (default): OpenRouter if OPENROUTER_API_KEY is set; otherwise, when run
#   from inside a codemie-claude session, Claude via the CodeMie proxy with no
#   key needed at all.  Key for OpenRouter: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Retrieval for follow-up questions.
#   lexical (default) - BM25 keyword index + LLM query expansion. Needs nothing
#                       beyond the OpenRouter key above. Always works.
#   codemie           - vector embeddings via the CodeMie proxy, if you have one.
# OpenRouter itself serves no embedding models.
# ---------------------------------------------------------------------------
EMBED_PROVIDER=lexical
CODEMIE_BASE_URL=
CODEMIE_API_KEY=
EMBED_MODEL=codemie-text-embedding-ada-002
RAG_TOP_K=10

# ---------------------------------------------------------------------------
# Deep-follow connectors - each degrades to "link only" without a token.
# GITHUB_TOKEN matters here: ProjectAlita/deployment_bits and EliteaAI/eliteaperf
# are private and 404 without one.
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://jiraeu.epam.com
JIRA_PAT=
GITHUB_TOKEN=

# GitLab (git.epam.com is EPAM's GitLab). A token is instance-specific: a
# git.epam.com token is NOT valid for eu.git.epam.com. Links on instances with no
# token are still recorded and grouped, just not opened.
GITLAB_BASE_URL=https://git.epam.com
GITLAB_TOKEN=
GITLAB_HOSTS=git.epam.com,eu.git.epam.com,gitbud.epam.com
# Extra instances, one token each, named after the host. EliteA's platform
# code (epm-elps/*) lives on gitbud.epam.com, which needs VPN access.
GITLAB_TOKEN_GITBUD_EPAM_COM=
GITLAB_TOKEN_EU_GIT_EPAM_COM=
MAX_GITLAB_ITEMS=25
FOLLOW_SHAREPOINT=true
FOLLOW_WEB=false

DOSSIER_DIR=./dossiers
